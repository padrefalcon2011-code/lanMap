{
  "_comment": "Поставляемая база отпечатков LanMap. Правило срабатывает, если выполнены ВСЕ условия из if и (если задан) хотя бы один набор из if_any. Значения в then могут ссылаться на факты: {onvif.Model}, {upnp.modelName}, {mdns_txt.md}. Уровни: exact, high, guess, weak. Никаких адресов конкретной сети здесь быть не должно.",
  "version": 1,
  "rules": [
    {"id": "this-computer", "if": {"is_local": true},
     "then": {"type": "computer"}, "level": "exact", "why": "Это компьютер, на котором запущен LanMap"},
    {"id": "gateway", "if": {"is_gateway": true},
     "then": {"type": "router"}, "level": "high", "why": "Адрес является шлюзом по умолчанию"},

    {"id": "keenetic", "if_any": [
        {"upnp": {"manufacturer": "(?i)keenetic"}}, {"http_text": "(?i)keenetic"}, {"oui": "(?i)keenetic"}],
     "then": {"type": "router", "vendor": "Keenetic"}, "level": "high", "why": "Признаки Keenetic в описании, веб-странице или MAC"},
    {"id": "mikrotik", "if_any": [{"port": [8291, 8728]}, {"http_text": "(?i)routeros|mikrotik"}],
     "then": {"type": "router", "vendor": "MikroTik"}, "level": "high", "why": "Winbox/API RouterOS или страница MikroTik"},
    {"id": "tplink-net", "if": {"oui": "(?i)tp-?link"}, "if_any": [{"port": [22, 80, 443]}],
     "then": {"type": "network", "vendor": "TP-Link"}, "level": "guess",
     "why": "MAC TP-Link и веб-панель/SSH — вероятно точка доступа, усилитель или коммутатор"},
    {"id": "tplink-web", "if": {"http_text": "(?i)tp-?link"},
     "then": {"type": "network", "vendor": "TP-Link"}, "level": "high", "why": "Веб-панель TP-Link"},

    {"id": "onvif-nvt", "if": {"wsd_type": "(?i)NetworkVideoTransmitter"},
     "then": {"type": "camera"}, "level": "high", "why": "WS-Discovery: устройство объявляет себя видеопередатчиком ONVIF"},
    {"id": "onvif-info", "if": {"onvif": "Model"},
     "then": {"type": "camera", "model": "{onvif.Model}", "firmware": "{onvif.FirmwareVersion}"},
     "level": "exact", "why": "ONVIF GetDeviceInformation сообщил производителя, модель и прошивку"},
    {"id": "xiongmai-ports", "if": {"port": [34567]}, "if_any": [{"port": [8899]}, {"port": [554]}],
     "then": {"type": "camera", "vendor": "Xiongmai (XM)"}, "level": "high",
     "why": "Порт 34567 (протокол DVRIP) вместе с ONVIF/RTSP — характерный набор камер Xiongmai"},
    {"id": "xiongmai-rtsp", "if": {"rtsp": "(?i)H264DVR"},
     "then": {"type": "camera", "vendor": "Xiongmai (XM)"}, "level": "high", "why": "RTSP-сервер H264DVR — прошивка камер Xiongmai"},
    {"id": "dahua", "if": {"port": [37777]},
     "then": {"type": "camera", "vendor": "Dahua"}, "level": "high", "why": "Порт 37777 — фирменный протокол Dahua"},
    {"id": "hikvision", "if": {"http_text": "(?i)hikvision|webcomponents"},
     "then": {"type": "camera", "vendor": "Hikvision"}, "level": "high", "why": "Веб-интерфейс Hikvision"},
    {"id": "rtsp-generic", "if": {"port": [554, 8554, 10554]},
     "then": {"type": "camera"}, "level": "guess", "why": "Открыт RTSP — так обычно отдают видео камеры и регистраторы"},

    {"id": "synology", "if_any": [
        {"upnp": {"manufacturer": "(?i)synology"}}, {"http_text": "(?i)synology|diskstation"}, {"oui": "(?i)synology"}],
     "then": {"type": "nas", "vendor": "Synology"}, "level": "high", "why": "Признаки Synology в описании, веб-странице или MAC"},
    {"id": "synology-model", "if": {"upnp": {"manufacturer": "(?i)synology", "modelName": "."}},
     "then": {"type": "nas", "vendor": "Synology", "model": "{upnp.modelName}"}, "level": "exact",
     "why": "Модель сообщена в UPnP-описании Synology"},
    {"id": "dlink-nas", "if": {"oui": "(?i)d-?link"}, "if_any": [{"ports_all": [445, 2049]}, {"mdns_service": "_smb\\._tcp"}],
     "then": {"type": "nas", "vendor": "D-Link"}, "level": "high", "why": "MAC D-Link и общие папки SMB/NFS — сетевое хранилище D-Link (серия DNS)"},
    {"id": "nas-generic", "if_any": [{"ports_all": [445, 2049]}, {"mdns_service": "_afpovertcp\\._tcp|_adisk\\._tcp"}],
     "if_not": {"is_local": true},
     "then": {"type": "nas"}, "level": "guess", "why": "Общие папки по SMB и NFS/AFP — похоже на сетевое хранилище"},

    {"id": "printer-mdns", "if": {"mdns_service": "_ipps?\\._tcp|_printer\\._tcp|_pdl-datastream\\._tcp"},
     "then": {"type": "printer", "vendor": "{mdns_txt.usb_mfg}", "model": "{mdns_txt.ty}"}, "level": "high",
     "why": "Устройство объявляет службу печати (IPP/LPD/RAW) в mDNS"},
    {"id": "printer-wsd", "if": {"wsd_type": "(?i)Print"},
     "then": {"type": "printer"}, "level": "high", "why": "WS-Discovery: служба печати"},
    {"id": "printer-ports", "if_any": [{"port": [631]}, {"port": [9100]}],
     "then": {"type": "printer"}, "level": "guess", "why": "Открыты порты печати (IPP 631 / RAW 9100)"},
    {"id": "epson", "if_any": [{"http_server": "(?i)epson"}, {"oui": "(?i)seiko epson"}],
     "then": {"type": "printer", "vendor": "Epson"}, "level": "high", "why": "Веб-сервер или MAC Epson"},

    {"id": "yandex-station", "if_any": [{"mdns_service": "_yandexio\\._tcp"}, {"port": [1961]}],
     "then": {"type": "speaker", "vendor": "Яндекс", "model": "{mdns_txt.platform}"}, "level": "high",
     "why": "Служба Яндекс (_yandexio / порт 1961) — Яндекс Станция"},
    {"id": "yandex-platform", "if": {"mdns_txt": {"platform": "(?i)^yandex"}},
     "then": {"type": "speaker", "vendor": "Яндекс", "model": "{mdns_txt.platform}"}, "level": "exact",
     "why": "Модель колонки сообщена в mDNS (platform)"},

    {"id": "google-cast", "if": {"mdns_service": "_googlecast\\._tcp"},
     "then": {"type": "media", "model": "{mdns_txt.md}"}, "level": "high", "why": "Google Cast: ТВ-приставка, телевизор или колонка с Chromecast"},
    {"id": "android-tv", "if_any": [{"mdns_service": "_androidtvremote2?\\._tcp"}, {"ports_all": [6466, 6467]}],
     "then": {"type": "media"}, "level": "high", "why": "Служба пульта Android TV"},
    {"id": "xiaomi-tv", "if_any": [{"upnp": {"modelName": "(?i)mitv|mibox"}}, {"upnp": {"friendlyName": "(?i)mitv|mibox"}}],
     "then": {"type": "media", "vendor": "Xiaomi", "model": "{upnp.modelName}"}, "level": "exact",
     "why": "UPnP-описание приставки Xiaomi (MiTV/MiBox)"},
    {"id": "samsung-tv", "if_any": [
        {"upnp": {"manufacturer": "(?i)samsung", "deviceType": "(?i)MediaRenderer|dial"}},
        {"upnp": {"friendlyName": "(?i)\\[TV\\]"}}, {"ports_all": [8001, 8002]}, {"port": [9197]}],
     "then": {"type": "tv", "vendor": "Samsung", "model": "{upnp.modelName}"}, "level": "high", "why": "Признаки телевизора Samsung (UPnP или порты Smart View)"},
    {"id": "lg-tv", "if_any": [{"upnp": {"manufacturer": "(?i)^LG"}}, {"ssdp_server": "(?i)webos"}, {"http_text": "(?i)webos"}],
     "then": {"type": "tv", "vendor": "LG", "model": "{upnp.modelName}"}, "level": "high", "why": "Признаки телевизора LG webOS"},
    {"id": "upnp-renderer", "if": {"upnp": {"deviceType": "(?i)MediaRenderer"}},
     "then": {"type": "media"}, "level": "guess", "why": "UPnP MediaRenderer — устройство воспроизведения (ТВ, приставка, колонка)"},
    {"id": "adb", "if": {"port": [5555]},
     "then": {"type": "media"}, "level": "guess", "why": "Открыт ADB 5555 — устройство на Android (часто ТВ-приставка)"},

    {"id": "apple-lockdown", "if": {"port": [62078]},
     "then": {"type": "phone", "vendor": "Apple"}, "level": "high", "why": "Порт 62078 (lockdown) есть только у iPhone и iPad"},
    {"id": "apple-tv", "if": {"mdns_txt": {"model": "(?i)AppleTV"}},
     "then": {"type": "media", "vendor": "Apple", "model": "{mdns_txt.model}"}, "level": "exact", "why": "Apple TV сообщает модель в mDNS"},
    {"id": "apple-mobile-mdns", "if": {"mdns_service": "_apple-mobdev2\\._tcp|_companion-link\\._tcp"},
     "then": {"type": "phone", "vendor": "Apple"}, "level": "guess", "why": "Службы Apple для мобильных устройств в mDNS"},

    {"id": "windows", "if_any": [{"ports_all": [135, 445]}, {"port": [5040]}, {"port": [3389]}],
     "then": {"type": "computer", "os": "Windows"}, "level": "high", "why": "Набор портов Windows (RPC, SMB, CDP, RDP)"},
    {"id": "hyperv", "if": {"port": [2179]},
     "then": {"type": "computer", "os": "Windows"}, "level": "high", "why": "Порт 2179 — консоль виртуальных машин Hyper-V"},
    {"id": "home-assistant", "if_any": [{"mdns_service": "_home-assistant\\._tcp"}, {"port": [8123]}],
     "then": {"type": "iot", "model": "Home Assistant"}, "level": "high", "why": "Сервер умного дома Home Assistant"},
    {"id": "mqtt", "if": {"port": [1883]},
     "then": {"type": "iot"}, "level": "guess", "why": "Открыт MQTT — брокер или устройство умного дома"},

    {"id": "phone-private-mac", "if": {"private_mac": true, "no_ports": true},
     "then": {"type": "phone"}, "level": "weak",
     "why": "Частный MAC и ни одной открытой службы — так выглядят телефоны, планшеты и ноутбуки"},
    {"id": "phone-vendor-mac", "if": {"oui": "(?i)xiaomi|apple|huawei|honor|samsung|oneplus|oppo|vivo|realme|motorola", "no_ports": true},
     "then": {"type": "phone"}, "level": "weak",
     "why": "MAC производителя телефонов и ни одной открытой службы — вероятно телефон или планшет"}
  ]
}
